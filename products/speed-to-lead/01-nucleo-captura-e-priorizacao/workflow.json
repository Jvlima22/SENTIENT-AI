    {
      "parameters": {
        "jsCode": "const payload = $json.body && typeof $json.body === 'object' ? $json.body : $json;\n\nconst text = (value) => String(value ?? '').trim();\n// Remove barras incluídas acidentalmente em cópias de e-mail, como ana\\@empresa.com.\nconst email = text(payload.email).replace(/\\\\/g, '').toLowerCase();\nconst phone = text(payload.phone || payload.whatsapp).replace(/\\D/g, '');\nconst normalizedPhone = phone && !phone.startsWith('55') && phone.length <= 11 ? `55${phone}` : phone;\nconst name = text(payload.name);\n\nconst validEmail = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nconst isValid = Boolean(name) && validEmail;\n\nreturn [{\n  json: {\n    lead_id: `lead_${Date.now()}`,\n    name,\n    email,\n    phone: normalizedPhone,\n    company: text(payload.company),\n    interest: text(payload.interest),\n    message: text(payload.message),\n    source: text(payload.source) || 'site',\n    utm_campaign: text(payload.utm_campaign),\n    page_url: text(payload.page_url),\n    contact_consent: payload.contact_consent === true || payload.contact_consent === 'true' || payload.contact_consent === 'on',\n    received_at: new Date().toISOString(),\n    is_valid: isValid,\n    validation_error: isValid ? '' : 'Confira nome e e-mail e tente novamente.'\n  }\n}];"
      },
